{
  "name": "@partneroj/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "3.6.4",
    "drizzle-orm": "0.45.4"
  },
  "dependencies": {
    "@partneroj/contracts": "workspace:*",
    "@partneroj/db": "workspace:*",
    "web-push": "3.6.7"
  }
}
