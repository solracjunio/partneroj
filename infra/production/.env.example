# Copy to .env on the server, next to compose.yml. Never commit .env.
# Passwords go inside connection URLs, so use hex (no URL-special chars):
#   openssl rand -hex 32

DOMAIN=partneroj.com.br

# Owner of the tables (Postgres superuser in the container). Set once,
# before the first deploy: Postgres reads it only when the volume is empty.
POSTGRES_PASSWORD=

# Login of the API and the worker (role partneroj_app). Changing it and
# deploying again rotates it.
APP_DB_PASSWORD=

# Encrypts the restic repository. Without it the backups can never be
# read: keep it in the password manager and on the sealed paper too.
RESTIC_PASSWORD=

# Host directory of the restic repository, owned by uid 70 (postgres in
# the backup image): sudo install -d -o 70 -g 70 -m 700 <dir>
BACKUP_DIR=/srv/partneroj-backup

# Push monitors of Uptime Kuma (docs/operacao.md), with the host changed
# to the service name, e.g. http://uptime-kuma:3001/api/push/<token>.
# Empty: no push. The tokens are secrets: whoever has one can fake a run.
BACKUP_PUSH_URL=
RESTORE_CHECK_PUSH_URL=
OFFSITE_PUSH_URL=

# Password of the user partneroj on the home PC's rest-server. The PC
# only gets its bcrypt hash (docs/operacao.md). Empty: no off-site copy.
OFFSITE_PASSWORD=

# Web Push (VAPID). Generated once, on the server (docs/operacao.md), and
# NEVER changed: every push subscription is tied to the public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid>: the external
# heartbeat (heartbeat-external.sh). Empty: no external heartbeat.
HEALTHCHECKS_PING_URL=
