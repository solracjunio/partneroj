# Copy to .env on the server, next to compose.yml. Never commit .env.
# Passwords go inside connection URLs, so use hex (no URL-special chars):
#   openssl rand -hex 32

DOMAIN=partneroj.com.br

# Owner of the tables (Postgres superuser in the container). Set once,
# before the first deploy: Postgres reads it only when the volume is empty.
POSTGRES_PASSWORD=

# Login of the API and the worker (role partneroj_app). Changing it and
# deploying again rotates it.
APP_DB_PASSWORD=
