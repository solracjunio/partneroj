{
  "name": "partneroj",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm --filter \"./packages/*\" build && vitest run --coverage",
    "complexity": "eslint --config eslint.complexity.config.js --format json --output-file reports/complexity/eslint.json apps packages",
    "hotspots": "pnpm complexity && node .github/scripts/hotspots.mjs",
    "quality": "pnpm coverage && pnpm --filter @partneroj/domain mutation && pnpm complexity && node .github/scripts/quality-summary.mjs",
    "test:scripts": "node --test .github/scripts/",
    "build": "pnpm -r --if-present build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
