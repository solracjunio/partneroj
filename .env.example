# Copy to .env for local development. Never commit .env.

# Docker Compose (Postgres for development)
POSTGRES_USER=partneroj
POSTGRES_PASSWORD=partneroj
POSTGRES_DB=partneroj
POSTGRES_PORT=5432

# API
PORT=3000
DATABASE_URL=postgres://partneroj:partneroj@localhost:5432/partneroj

# Web Push (optional in development): the public VAPID key. Without it,
# GET /api/notifications/vapid-key answers 503 and the app does not offer
# notifications. The private key belongs to the worker only, which does
# not start without the three (apps/worker/src/config.ts).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://partneroj.com.br
